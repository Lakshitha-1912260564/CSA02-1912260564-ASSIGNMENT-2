
#include <stdio.h>

#define N 1000

int calls = 0;

/* Slow verification function */
int verify_card(int id)
{
    calls++;
    return 0;
}

/* Version 1: Cheap condition first */
int check1(int senior, int eligible, int id)
{
    return (senior && eligible) || verify_card(id);
}

/* Version 2: Server verification first */
int check2(int senior, int eligible, int id)
{
    return verify_card(id) || (senior && eligible);
}

/* Version 3: Nested if */
int check3(int senior, int eligible, int id)
{
    if (senior && eligible)
        return 1;

    if (verify_card(id))
        return 1;

    return 0;
}

/* Version 4: Bitwise operators */
int check4(int senior, int eligible, int id)
{
    return ((senior & eligible) |
            verify_card(id)) != 0;
}

int main()
{
    int senior[N], eligible[N];
    int result;

    /* Generate 1000 passengers */
    for (int i = 0; i < N; i++)
    {
        senior[i] = (i % 4 == 0);
        eligible[i] = 1;
    }

    calls = 0;

    for (int i = 0; i < N; i++)
        result = check1(senior[i], eligible[i], i);

    printf("Condition first: %d calls\n", calls);

    calls = 0;

    for (int i = 0; i < N; i++)
        result = check2(senior[i], eligible[i], i);

    printf("Server first: %d calls\n", calls);

    calls = 0;

    for (int i = 0; i < N; i++)
        result = check3(senior[i], eligible[i], i);

    printf("Nested if: %d calls\n", calls);

    calls = 0;

    for (int i = 0; i < N; i++)
        result = check4(senior[i], eligible[i], i);

    printf("Bitwise operators: %d calls\n", calls);

    return 0;
}
