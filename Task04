#include <stdio.h>

int main()
{
    double price, gross, discount, taxable;
    double gst, total, net;
    int qty, senior;

    printf("Enter unit price: ");
    scanf("%lf", &price);

    printf("Enter quantity: ");
    scanf("%d", &qty);

    printf("Senior citizen? (1=yes, 0=no): ");
    scanf("%d", &senior);

    /* Original expression */
    double original_total =
        price * qty - price * qty * 15 / 100 * senior
        + price * qty * 5 / 100;

    double original_net =
        original_total > 1000
        ? original_total - 50 : original_total;

    /* Correct calculation */
    gross = price * qty;

    if (senior == 1)
        discount = gross * 0.15;
    else
        discount = 0;

    taxable = gross - discount;

    gst = taxable * 0.05;

    total = taxable + gst;

    if (total > 1000)
        net = total - 50;
    else
        net = total;

    printf("\nOriginal Total: %.2f\n", original_total);
    printf("Original Net: %.2f\n", original_net);

    printf("\nCorrect Calculation\n");
    printf("Gross Amount: %.2f\n", gross);
    printf("Discount: %.2f\n", discount);
    printf("Taxable Amount: %.2f\n", taxable);
    printf("GST: %.2f\n", gst);
    printf("Total: %.2f\n", total);
    printf("Net Amount: %.2f\n", net);

    /* Correct replacement for count = count++ + 1 */
    int count = 0;
    count = count + 1;

    printf("Count: %d\n", count);

    return 0;
}
