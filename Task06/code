#include <stdio.h>

#define MAX_MONTHS 360

int main()
{
    double principal, rate, repayment;
    double balance, interest;
    double total_interest = 0;

    int month = 0;

    printf("Enter loan amount: ");
    scanf("%lf", &principal);

    printf("Enter monthly interest rate (%%): ");
    scanf("%lf", &rate);

    printf("Enter monthly repayment: ");
    scanf("%lf", &repayment);

    if (principal <= 0 || rate < 0 || repayment <= 0)
    {
        printf("Invalid input\n");
        return 1;
    }

    rate = rate / 100.0;

    if (repayment <= principal * rate)
    {
        printf("Loan cannot be repaid with this amount.\n");
        return 1;
    }

    balance = principal;

    printf("\nMonth\tOpening\t\tInterest\tPayment\t\tClosing\n");

    while (balance > 0.005)
    {
        if (month >= MAX_MONTHS)
        {
            printf("Maximum repayment period reached.\n");
            return 0;
        }

        month++;

        double opening = balance;

        interest = opening * rate;

        balance = balance + interest;

        total_interest += interest;

        double payment = repayment;

        if (payment > balance)
            payment = balance;

        balance = balance - payment;

        if (balance < 0.005)
            balance = 0;

        printf("%d\t%.2f\t\t%.2f\t\t%.2f\t\t%.2f\n",
               month,
               opening,
               interest,
               payment,
               balance);
    }

    printf("\nLoan fully repaid!\n");

    printf("Total months: %d\n", month);

    printf("Total interest paid: Rs. %.2f\n",
           total_interest);

    return 0;
}
