
#include <stdio.h>

int main()
{
    float price, gross, discount, tax, total, net;
    int qty, senior;

    printf("Enter product price: ");
    scanf("%f", &price);

    printf("Enter quantity: ");
    scanf("%d", &qty);

    printf("Is the customer a senior citizen? (1=Yes, 0=No): ");
    scanf("%d", &senior);

    gross = price * qty;

    if (senior == 1)
        discount = gross * 15.0 / 100;
    else
        discount = 0;

    tax = (gross - discount) * 5.0 / 100;

    total = (gross - discount) + tax;

    net = (total > 1000) ? (total - 50) : total;

    printf("\nGross Amount = Rs. %.2f", gross);
    printf("\nDiscount = Rs. %.2f", discount);
    printf("\nGST = Rs. %.2f", tax);
    printf("\nTotal Amount = Rs. %.2f", total);
    printf("\nNet Payable = Rs. %.2f\n", net);

    return 0;
}
