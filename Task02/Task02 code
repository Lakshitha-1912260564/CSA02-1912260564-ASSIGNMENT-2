#include <stdio.h>

int calls = 0;

int verifyCard()
{
    calls++;
    printf("Verifying disability card...\n");
    return 0;
}

int main()
{
    int senior, eligible;
    int concession;
    int i;

    // Experiment 1: AND short-circuit
    calls = 0;
    if (0 && verifyCard())
        printf("Eligible\n");

    printf("AND calls = %d\n\n", calls);

    // Experiment 2: OR short-circuit
    calls = 0;
    if (1 || verifyCard())
        printf("Eligible\n");

    printf("OR calls = %d\n\n", calls);

    // Experiment 3: Condition order
    senior = 0;
    eligible = 1;

    calls = 0;
    if ((senior && eligible) || verifyCard())
        printf("Concession granted\n");

    printf("Normal order calls = %d\n\n", calls);

    calls = 0;
    if (verifyCard() || (senior && eligible))
        printf("Concession granted\n");

    printf("Reversed order calls = %d\n\n", calls);

    // Experiment 4: Bitwise AND
    calls = 0;
    if (0 & verifyCard())
        printf("Yes\n");

    printf("Bitwise AND calls = %d\n\n", calls);

    // Experiment 5: 1000 passengers
    calls = 0;

    for (i = 0; i < 1000; i++)
    {
        if (i < 200)
        {
            senior = 1;
            eligible = 1;
        }
        else if (i < 300)
        {
            senior = 1;
            eligible = 0;
        }
        else
        {
            senior = 0;
            eligible = 1;
        }

        if ((senior && eligible) || verifyCard())
            concession = 1;
        else
            concession = 0;
    }

    printf("Short-circuit calls for 1000 passengers = %d\n", calls);

    calls = 0;

    for (i = 0; i < 1000; i++)
    {
        if (i < 200)
        {
            senior = 1;
            eligible = 1;
        }
        else if (i < 300)
        {
            senior = 1;
            eligible = 0;
        }
        else
        {
            senior = 0;
            eligible = 1;
        }

        if (verifyCard() || (senior && eligible))
            concession = 1;
        else
            concession = 0;
    }

    printf("Reversed order calls for 1000 passengers = %d\n", calls);

    // Experiment 6: Audit logging for every passenger
    calls = 0;

    for (i = 0; i < 1000; i++)
    {
        senior = (i < 200);
        eligible = (i < 300);

        int cardValid = verifyCard();

        if ((senior && eligible) || cardValid)
            concession = 1;
        else
            concession = 0;
    }

    printf("Audit-required calls = %d\n", calls);

    return 0;
}
